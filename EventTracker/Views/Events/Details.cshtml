@model EventTracker.Models.EventModel

@{
    ViewData["Title"] = "Etkinlik Detayları";
}

<div class="container mt-4">
    <h2>Etkinlik Detayları</h2>
    <hr />

    <div class="card shadow-sm" style="max-width: 600px;">
        <div class="card-body">
            <h4 class="card-title text-primary">@Model.Title</h4>
            <p class="card-text">
                <strong>Açıklama:</strong> @Model.Description
            </p>
            <p class="card-text">
                <strong>Tarih:</strong> @Model.Date.ToString("dd.MM.yyyy HH:mm")
            </p>
            <p class="card-text">
                <strong>Sistem ID:</strong> #@Model.Id
            </p>
        </div>
        <div class="card-footer bg-transparent">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
            
            <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
        </div>
    </div>
</div>