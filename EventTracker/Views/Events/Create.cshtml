@model EventTracker.Models.EventModel

@{
    ViewData["Title"] = "Yeni Etkinlik Oluştur";
}

<div class="container mt-4">
    <h2>Yeni Etkinlik Oluştur</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label class="control-label">Etkinlik Başlığı</label>
                    <input asp-for="Title" class="form-control" placeholder="Başlık giriniz..." required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Etkinlik detayları..."></textarea>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Etkinlik Tarihi</label>
                    <input asp-for="Date" type="datetime-local" class="form-control" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal / Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>