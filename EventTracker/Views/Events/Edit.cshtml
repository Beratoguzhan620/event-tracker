@model EventTracker.Models.EventModel

@{
    ViewData["Title"] = "Etkinliği Düzenle";
}

<div class="container mt-4">
    <h2>Etkinliği Düzenle</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label class="control-label">Etkinlik Başlığı</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Etkinlik Tarihi</label>
                    <input asp-for="Date" type="datetime-local" class="form-control" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-warning">Değişiklikleri Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>