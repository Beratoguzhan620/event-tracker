@using Microsoft.AspNetCore.Http.Extensions
@model PagerViewModel
@{
    string PageUrl(int page)
    {
        var query = new QueryBuilder(Context.Request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string>(q.Key, v ?? string.Empty))));
        if (page > 1) query.Add("page", page.ToString());
        return Context.Request.Path + query.ToQueryString();
    }
    var first = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var last = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
}
@if (Model.TotalCount > 0)
{
    <div class="pagination-bar">
        <span>@Model.TotalCount etkinlikten @first–@last arası</span>
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Sayfalar">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.Page > 1 ? null : "disabled")">
                        <a class="page-link" href="@(Model.Page > 1 ? PageUrl(Model.Page - 1) : null)" aria-label="Önceki sayfa"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (Model.TotalPages > 7 && p != 1 && p != Model.TotalPages && Math.Abs(p - Model.Page) > 1)
                        {
                            if (p == 2 || p == Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            continue;
                        }
                        <li class="page-item @(p == Model.Page ? "active" : null)">
                            <a class="page-link" href="@PageUrl(p)" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page < Model.TotalPages ? null : "disabled")">
                        <a class="page-link" href="@(Model.Page < Model.TotalPages ? PageUrl(Model.Page + 1) : null)" aria-label="Sonraki sayfa"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
